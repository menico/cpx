{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cpx",
  "version": "0.1.3",
  "identifier": "io.github.menico.cpx",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cpx",
        "width": 420,
        "height": 620,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
